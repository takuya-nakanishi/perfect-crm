# 画面(ビルド済みの静的ファイル)を配る。TLS は手前の Cloudflare(Tunnel)が持つので、ここは平文の HTTP だけ。
# 認証は api(アプリ自身のログイン)が持つ。手前に門(Cloudflare Access)は無い(docs/design/06 §2・§3)。
# /api/* と MCP・OAuth の口は api(FastAPI)へ流す。画面と API を同じオリジンに置き、Cookie と CSP を単純に保つ。
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# 画面は自分のオリジンの資源だけで完結する。style の 'unsafe-inline' は React の style 属性のため
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# https だけで開かせる(このホストだけ。ブラウザは http で受けたこの値を無視するので、手元の 127.0.0.1 には効かない)
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# 稼働確認(compose の healthcheck が叩く)
	handle /healthz {
		respond "ok" 200
	}

	# API(profile backend で起動する。起動していなければ 502。画面が mock モードなら呼ばない)。
	# 本文は 20 MB まで(超えたら 413)。api は本文を読み終えてから認証を確かめるので、だれからでも届く口に
	# 大きな本文を送りつけられてもメモリを食わせない。いちばん大きいのは CSV の取り込み(04 §7)
	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy api:8000
	}

	# MCP と、Claude のカスタムコネクタが通る OAuth の口(docs/design/03 §6・04 §13)。Host はそのまま api へ渡す
	# (api が公開 URL のホストかを確かめる)。/oauth/consent は画面のページなので、ここには含めない
	@mcp path /mcp /mcp/* /authorize /token /register /revoke /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @mcp {
		reverse_proxy api:8000
	}

	# ファイル名にハッシュが入るので、変わらないものとして長く持たせる。無いファイルは 404(index.html で誤魔化さない)
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# それ以外は SPA。どのパスでも index.html を返し、毎回更新を確かめさせる。
	# no-transform は Cloudflare に HTML を書き換えさせないため。これが無いと、ゾーンの Web Analytics(自動挿入)が
	# ビーコンのスクリプトを差し込み、上の CSP に止められてコンソールにエラーが出続ける。ホスト単位で除外するルールは
	# 無料プランでは作れない(maxRulesError)ので、配る側で断る
	handle {
		header Cache-Control "no-cache, no-transform"
		try_files {path} /index.html
		file_server
	}
}
