# Cloudflare(sanei-clover.com のDNS・Pages操作用)
# 変数名は公式ツール(wrangler / Terraform / flarectl)が自動で読む標準名。変更しないこと
CLOUDFLARE_API_TOKEN=

# アカウントID(ダッシュボード右下 or Workers & Pages画面。Pagesデプロイに必要)
CLOUDFLARE_ACCOUNT_ID=

# sanei-clover.com のZone ID(ダッシュボード→sanei-clover.com→Overview右下)
CLOUDFLARE_ZONE_ID=

# --- Claude Code セッション(アプリは読まない。エージェント運用用) ---
# セッション名に使うリポジトリ略称。名前は {略称}-{キーワード}(例: pcrm-データモデル)。
# 複数リポジトリのセッションを同時に走らせたとき、どれがどれか一目で分かるようにするためのもの
REPO_SLUG=pcrm
