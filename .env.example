# perfect-crm の環境変数。実体は .env(git 管理外)。値はすべて自分で生成する(例: openssl rand -base64 24)
# .env はリポジトリ直下に 1 つだけ置く。contacts/ の compose は `--env-file ../.env` を付けて動かし、スクリプトは直下の .env を読む

# --- Claude Code セッション(アプリは読まない。エージェント運用用) ---
# セッション名に使うリポジトリ略称。名前は {略称}-{キーワード}(例: pcrm-データモデル)。
# 複数リポジトリのセッションを同時に走らせたとき、どれがどれか一目で分かるようにするためのもの
REPO_SLUG=pcrm

# --- Cloudflare(sanei-clover.com の DNS、contacts の Tunnel / Access。README「スマホからの経路」) ---
# 変数名は公式ツール(wrangler / Terraform / flarectl)が自動で読む標準名。変更しないこと
# Custom トークン。必要なのは次の 2 行(Zone 側を空にすると DNS が読めない)。現行トークンはこれより広い(受け入れたリスク。docs/contacts.md)
#   Zone    : DNS:Edit → Include / Specific zone / sanei-clover.com
#   Account : Cloudflare Tunnel:Edit + Access: Apps and Policies:Edit + Access: Organizations, Identity Providers, and Groups:Edit → 自分のアカウント
CLOUDFLARE_API_TOKEN=
# アカウント ID(ダッシュボード右下 or Workers & Pages 画面)
CLOUDFLARE_ACCOUNT_ID=
# sanei-clover.com の Zone ID(ダッシュボード → sanei-clover.com → Overview 右下)。contacts のスクリプトは名前で引くので無くても動く
CLOUDFLARE_ZONE_ID=
# scripts/cloudflare-tunnel-setup.py が書く。cloudflared(profile public)が使う
CLOUDFLARE_TUNNEL_TOKEN=

# --- contacts/: PostgreSQL(contacts/docker-compose.yml の db) ---
# 所有者ロール contacts のパスワード。スキーマ変更のときだけ人間が使う
CONTACTS_DB_PASSWORD=
# AI 共用ロール contacts_agent(Claude Code / Codex)。db/002-roles.sql で作成
CONTACTS_AGENT_DB_PASSWORD=
# 画面ロール contacts_ui(NocoDB が台帳へ接続するときに使う)。db/002-roles.sql で作成
CONTACTS_UI_DB_PASSWORD=

# --- contacts/: NocoDB(contacts/docker-compose.yml の ui) ---
# 管理者アカウント。scripts/nocodb-setup.py が初回 signup に使う
CONTACTS_UI_ADMIN_EMAIL=you@example.com
CONTACTS_UI_ADMIN_PASSWORD=
# scripts/nocodb-setup.py が作ったベースの ID(作成後に控える。attach-source が使う)
CONTACTS_UI_BASE_ID=
# 公開後の URL。未設定なら http://localhost:8090
#CONTACTS_UI_PUBLIC_URL=https://works.example.com
