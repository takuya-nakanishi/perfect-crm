# Works(perfect-crm)の環境変数。実体は .env(git 管理外)。値はすべて自分で生成する
# .env はリポジトリ直下に 1 つだけ置く。直下の docker-compose.yml と scripts/ がこれを読む

# --- Claude Code セッション(アプリは読まない。エージェント運用用) ---
# セッション名に使うリポジトリ略称。名前は {略称}-{キーワード}(例: pcrm-データモデル)。
# 複数リポジトリのセッションを同時に走らせたとき、どれがどれか一目で分かるようにするためのもの
REPO_SLUG=pcrm

# --- Cloudflare(sanei-clover.com の DNS、works.sanei-clover.com の Tunnel と Access。docs/design/06) ---
# 変数名は公式ツール(wrangler / Terraform / flarectl)が自動で読む標準名。変更しないこと
# Custom トークン。必要なのは次の 2 行(Zone 側を空にすると DNS が読めない)。現行トークンはこれより広い(受け入れたリスク。docs/design/06 §2)
#   Zone    : DNS:Edit → Include / Specific zone / sanei-clover.com
#   Account : Cloudflare Tunnel:Edit + Access: Apps and Policies:Edit + Access: Organizations, Identity Providers, and Groups:Edit
#             + Access: Service Tokens:Edit(scripts/cloudflare-access-check.py が一時のトークンを作るため)→ 自分のアカウント
CLOUDFLARE_API_TOKEN=
# アカウント ID(ダッシュボード右下 or Workers & Pages 画面)
CLOUDFLARE_ACCOUNT_ID=
# sanei-clover.com の Zone ID(ダッシュボード → sanei-clover.com → Overview 右下)。scripts/ は名前で引くので無くても動く
CLOUDFLARE_ZONE_ID=
# scripts/cloudflare-tunnel-setup.py が書く(Tunnel を作り直すと置き換える)。cloudflared(profile public)が使う
CLOUDFLARE_TUNNEL_TOKEN=

# --- 画面(docker-compose.yml の web) ---
# ホスト側で待ち受けるポート(127.0.0.1 のみ)。既定 8610
WEB_PORT=8610
# mock = ブラウザ内の擬似 DB で動かす / http = バックエンドの /api/v1 を叩く(frontend/src/api/client.ts)
VITE_API_MODE=mock

# --- PostgreSQL(docker-compose.yml の db。profile backend) ---
# 記号を含めない。例: openssl rand -hex 24
WORKS_DB_PASSWORD=
# ホスト側に出す db のポート(127.0.0.1 のみ。pytest が実物に繋ぐため)。既定 55432
WORKS_DB_PORT=55432

# --- バックエンド(docker-compose.yml の api。backend/README.md) ---
# セッション Cookie の署名と、Google の鍵の暗号化に使う。例: openssl rand -hex 32
# **空だと再起動のたびに鍵が変わり、ログインし直し + Google の繋ぎ直しになる**
WORKS_SECRET_KEY=
# 最初の管理者。初回の `python -m app.cli init` だけが使う。空だと管理者が作られずログインできない
WORKS_ADMIN_EMAIL=
WORKS_ADMIN_NAME=管理者

# --- Google ドライブ(drive_files 型の項目。docs/design/04 §8、手順は docs/runbook/01 §6) ---
# GCP プロジェクト citric-earth-449901-e7(カスタム MCP と同じ)の OAuth クライアント(種類はウェブ アプリケーション)。
# 同意画面は「内部」で作る(drive.readonly が制限付きスコープでも審査が要らなくなる)。空ならドライブの API は 503 を返す
WORKS_GOOGLE_CLIENT_ID=
WORKS_GOOGLE_CLIENT_SECRET=
# 許可のあとの戻り先。**GCP に登録したリダイレクト URI と 1 文字も違ってはいけない**
# 既定は https://works.sanei-clover.com/api/v1/google/callback(変えるときだけ書く)
WORKS_GOOGLE_REDIRECT_URI=
